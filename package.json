{
  "name": "oti-recovery-app",
  "version": "1.3.2",
  "private": true,
  "description": "Over the Influence Recovery companion app: events calendar, phone list, sobriety tools, stories, and resources. Web (PWA) + Android + iOS via Capacitor.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "validate:content": "node scripts/validate-content.mjs",
    "check": "npm run validate:content && npm run typecheck && npm test && npm run build",
    "sync": "npm run build && cap sync",
    "android:open": "cap open android",
    "android:bundle": "npm run sync && cd android && ./gradlew bundleRelease",
    "android:apk-debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "ios:open": "cap open ios",
    "assets": "capacitor-assets generate --iconBackgroundColor '#FFFFFF' --iconBackgroundColorDark '#1A1124' --splashBackgroundColor '#FFFFFF' --splashBackgroundColorDark '#1A1124'",
    "screenshots": "node scripts/screenshots.mjs",
    "keystore": "bash scripts/gen-keystore.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
